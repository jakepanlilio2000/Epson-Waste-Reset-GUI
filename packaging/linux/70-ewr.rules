# EWR: the logged-in user and plugdev group may open Epson USB printers without sudo.
# uaccess grants seat users (systemd on Fedora, Ubuntu, Debian, Arch), and MODE 0666 covers Raspberry Pi, headless, and SSH sessions.
SUBSYSTEM=="usb", ATTR{idVendor}=="04b8", MODE="0666", GROUP="plugdev", TAG+="uaccess"
